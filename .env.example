# Required in production. Min 32 random bytes (hex or base64).
SESSION_SECRET=replace-with-at-least-32-characters-of-entropy

# Public origin used for SIWE/SIWS domain binding and CSRF origin checks.
APP_ORIGIN=http://localhost:3000

# Optional. Enables the Phase 0 paper-fill endpoint. NEVER enable on a public production host.
ALLOW_MOCK_SWAPS=true

# Optional. Min 16 chars. Gates /admin and POST /v1/admin/*.
ADMIN_SECRET=

# Neon Postgres or Docker/local Postgres. Empty = PGlite under .data/t2c.
# Neon: postgresql://...@ep-....neon.tech/neondb?sslmode=require
# Docker / hostdev: postgresql://t2c:t2c@localhost:5432/trade2credits
# Compose app service injects postgresql://t2c:t2c@postgres:5432/trade2credits
DATABASE_URL=

# Optional. Hides WalletConnect if empty.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public site URL for metadata (ogfolio-sized OG image).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. LI.FI partner key (https://portal.li.fi). Public quote/status still work without it.
LIFI_API_KEY=

# Optional for quotes (public v1 estimate still works). Required to open a pay-in.
# Create a key at https://changenow.io — header x-changenow-api-key.
CHANGENOW_API_KEY=

# Optional. Shared Zerion key for 90-day wallet scans (https://developers.zerion.io).
# All users share this key. The desk queues calls (2/sec) and reuses a 15-minute scan.
# Without it, users can still import a tx hash that LI.FI can verify.
ZERION_API_KEY=

# Preferred: one Vercel AI Gateway credential covers OpenAI, Anthropic, DeepSeek, Google.
# Local: create a key at vercel.com/dashboard → AI Gateway, or `vercel env pull`.
# Deployed on Vercel: OIDC is automatic (VERCEL_OIDC_TOKEN). No provider keys needed.
AI_GATEWAY_API_KEY=

# Optional fallbacks. Only needed if AI Gateway is unset. Virtual t2c_ keys never see these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# Robinhood USDG payouts. Private key is server-only. Never commit it.
# Local: a valid TREASURY_PRIVATE_KEY is enough. Set TREASURY_ENABLED=false to keep payouts queued.
# Production: TREASURY_ENABLED=true, TREASURY_LIVE=true, and the key.
TREASURY_ENABLED=false
TREASURY_LIVE=false
TREASURY_PRIVATE_KEY=

# Optional on the host. Required in production. Prefer REDIS_URL.
# Docker / hostdev: redis://localhost:6379
# Compose app service injects redis://redis:6379
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=default
REDIS_PASSWORD=

# Vercel Cron and the local desk ticker send Authorization: Bearer $CRON_SECRET
# Min 16 characters. Local next dev ticks /api/v1/jobs/payouts and /settles every minute.
CRON_SECRET=

# Optional. Shared secrets for provider settle webhooks.
LIFI_WEBHOOK_SECRET=
CHANGENOW_WEBHOOK_SECRET=
