# Copy to .env.production and fill every required line.
#   cp .env.production.example .env.production
# Never commit .env.production.

NODE_ENV=production
ALLOW_MOCK_SWAPS=false

# Required. 32+ random characters.
SESSION_SECRET=

# Public https origin. Must match the URL wallets sign against.
APP_ORIGIN=https://accrued.trade
NEXT_PUBLIC_APP_URL=https://accrued.trade

# Compose injects these if you leave them blank.
POSTGRES_USER=t2c
POSTGRES_PASSWORD=
POSTGRES_DB=trade2credits
DATABASE_URL=postgresql://t2c:CHANGE_ME@postgres:5432/trade2credits

REDIS_URL=redis://redis:6379

# Required. Authorizes payout and settle jobs.
CRON_SECRET=

# Optional. Gates /admin.
ADMIN_SECRET=

# Optional. Vercel AI Gateway covers Anthropic, OpenAI, DeepSeek, Google, Grok, Mistral, Meta, Cohere, Perplexity, and Moonshot.
AI_GATEWAY_API_KEY=

# Optional fallbacks if Gateway is unset.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
MOONSHOT_API_KEY=

# Swap router and wallet scan (server-only).
LIFI_API_KEY=
CHANGENOW_API_KEY=
# Alchemy: key only (not the full RPC URL). Enables multi-chain scan; Zerion fills gaps.
ALCHEMY_API_KEY=
ZERION_API_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Robinhood USDG. Production needs enabled + live + the key to broadcast.
# Claims pay through UsdgRewardVault. Deploy with: npx tsx scripts/deploy-reward-vault.ts
TREASURY_ENABLED=false
TREASURY_LIVE=false
TREASURY_PRIVATE_KEY=
REWARD_VAULT_ADDRESS=

# Robinhood stock tokens (NVDA, AAPL, MSFT). Payouts transfer from inventory wallet.
STOCK_INVENTORY_WALLET=0xd53019bdCb79D918Da115B1a6A8cA454b09E28c0
# Optional. Defaults to TREASURY_PRIVATE_KEY when the key controls the inventory wallet.
STOCK_TREASURY_PRIVATE_KEY=
# Optional USD price overrides per share (cents).
# NVDA_USD_CENTS=14000
# AAPL_USD_CENTS=23000
# MSFT_USD_CENTS=42000
# Show demo treasury balances (NVDA 0.44, AAPL 0.31, MSFT 0.20) when chain reads are low.
STOCK_DEMO_INVENTORY=true

LIFI_WEBHOOK_SECRET=
CHANGENOW_WEBHOOK_SECRET=

# Privy wallet login. Create an app at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=

# x402 agent payments (MeshGateway facilitator + USDG on Robinhood Chain).
# Register merchant at https://meshgateway.co/ then fill facilitator URL + merchant ID.
X402_ENABLED=false
MESHGATEWAY_FACILITATOR_URL=https://facilitator.meshgateway.co
MESHGATEWAY_MERCHANT_ID=
X402_RECIPIENT_WALLET=0x183B3C77F26676E1C12BCA55080d4cA20F7C5a66
X402_DEFAULT_MAX_PRICE_USDG=0.05
# Optional. Self-hosted settle without facilitator (uses Permit2 relayer). Defaults to TREASURY_PRIVATE_KEY.
# X402_RELAYER_PRIVATE_KEY=
# X402_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Accrued v2 — pause USDG claims and enable ACCR deposit desk.
ACCRUED_V2_UPGRADE=true
ACCR_DEPOSIT_WALLET=0xDD307f8A4aabd805f0bF9EFC510A22DA09cb2018
# Optional override when DexScreener is unreachable from the host (e.g. 0.00009).
# If unset, the desk uses live DexScreener then a built-in default (~$0.00009).
ACCR_PRICE_USD=0.00009
DEPOSIT_DISPLAY_MULTIPLIER=2
DEPOSIT_GRANT_BPS=6000
DEPOSIT_MIN_USD_CENTS=500

# AI Create (Replicate) — server-only token, never expose to browser.
REPLICATE_API_TOKEN=
AI_CREATE_ENABLED=true
AI_CREATE_MAX_CONCURRENT=2
AI_CREATE_DAILY_CAP_CENTS=2000
REPLICATE_DAILY_BUDGET_CENTS=50000
# Replicate webhook signing secret (whsec_… from GET /v1/webhooks/default/secret).
REPLICATE_WEBHOOK_SECRET=
# Persist outputs locally in dev; set false in production when using R2.
AI_STORAGE_LOCAL=false
# Optional Cloudflare R2 (S3-compatible) for durable AI outputs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Landing hero stat floors (seeded on boot into public_desk_stats_baseline).
# Live wallet / LLM / volume totals from the DB grow above these values.
# Defaults: 45 active wallets, $85 claimed LLM, $350,000 swap volume.

# Host port for the app container.
APP_PORT=3000
